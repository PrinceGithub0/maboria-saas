  title                 String
  message               String
  type                  AdminNotificationType
  severity              AdminNotificationSeverity
  sourceEventType       String                            @map("source_event_type")
  sourceEventId         String?                           @map("source_event_id")
  dedupeKey             String                            @map("dedupe_key")
  occurrences           Int                               @default(1)
  firstSeenAt           DateTime                          @default(now()) @map("first_seen_at")
  lastSeenAt            DateTime                          @default(now()) @map("last_seen_at")
  status                AdminNotificationStatus           @default(UNREAD)
  snoozedUntil          DateTime?                         @map("snoozed_until")
  acknowledgedAt        DateTime?                         @map("acknowledged_at")
  acknowledgedByAdmin   User?                             @relation("AdminNotificationAcknowledgedBy", fields: [acknowledgedByAdminId], references: [id], onDelete: SetNull)
  acknowledgedByAdminId String?                           @map("acknowledged_by_admin_id")
  resolvedAt            DateTime?                         @map("resolved_at")
  resolvedByAdmin       User?                             @relation("AdminNotificationResolvedBy", fields: [resolvedByAdminId], references: [id], onDelete: SetNull)
  resolvedByAdminId     String?                           @map("resolved_by_admin_id")
  metadata              Json                              @default("{}")
  audits                AdminNotificationAudit[]
  createdAt             DateTime                          @default(now()) @map("created_at")
  updatedAt             DateTime                          @updatedAt @map("updated_at")

  @@index([recipientAdminId, status, createdAt])
  @@index([recipientAdminId, severity, createdAt])
  @@index([dedupeKey])
  @@index([lastSeenAt])
  @@index([status, snoozedUntil])
  @@index([tenantId])
  @@map("admin_notifications")
}

model AdminNotificationAudit {
  id             String                    @id @default(uuid())
  notification   AdminNotification         @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  notificationId String                    @map("notification_id")
  actorAdmin     User                      @relation("AdminNotificationAuditActor", fields: [actorAdminId], references: [id], onDelete: Cascade)
  actorAdminId   String                    @map("actor_admin_id")
  action         String
  fromStatus     AdminNotificationStatus?  @map("from_status")
  toStatus       AdminNotificationStatus?  @map("to_status")
  details        Json                      @default("{}")
  createdAt      DateTime                  @default(now()) @map("created_at")

  @@index([notificationId, createdAt])
  @@map("admin_notification_audits")
}

model AdminNotificationRule {
  id                  String                            @id @default(uuid())
  eventType           String                            @unique @map("event_type")
  defaultSeverity     AdminNotificationSeverity         @map("default_severity")
  defaultType         AdminNotificationType             @map("default_type")
  enabled             Boolean                           @default(true)
  recipientStrategy   AdminNotificationRecipientStrategy @map("recipient_strategy")
  roleKey             String?                           @map("role_key")
  dedupeStrategy      AdminNotificationDedupeStrategy   @map("dedupe_strategy")
  dedupeWindowSeconds Int                               @default(300) @map("dedupe_window_seconds")
  templateTitle       String                            @map("template_title")
  templateMessage     String                            @map("template_message")
  metadataTemplate    Json                              @default("{}") @map("metadata_template")
  createdAt           DateTime                          @default(now()) @map("created_at")
  updatedAt           DateTime                          @updatedAt @map("updated_at")

  @@index([eventType, enabled])
  @@map("admin_notification_rules")
}

model AdminIncident {
  id               String                  @id @default(uuid())
  title            String
  status           AdminIncidentStatus     @default(ACTIVE)
  severity         AdminNotificationSeverity
  startedAt        DateTime                @default(now()) @map("started_at")
  resolvedAt       DateTime?               @map("resolved_at")
  summary          String?
  createdByAdmin   User?                   @relation("AdminIncidentCreator", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  createdByAdminId String?                 @map("created_by_admin_id")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  @@index([status, startedAt])
  @@map("admin_incidents")
}

model AiConversation {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  title         String
  lastMessageAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  messages      AiMessage[]

  @@index([userId, lastMessageAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  user           User           @relation(fields: [userId], references: [id])
  userId         String
  role           String
  content        String
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
  @@index([userId, createdAt])
}

model AiMemory {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())
}

model UsageRecord {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  category  String
  amount    Int
  period    String
  createdAt DateTime @default(now())
}

model AnalyticsEvent {
  id         String            @id @default(cuid())
  user       User              @relation(fields: [userId], references: [id])
  userId     String
  orgId      String?
  workspaceId String?
  type       AnalyticsEventType?
  day        DateTime?
  category   AnalyticsCategory?
  count      Int               @default(1)
  tokenCount Int?
  source     String            @default("system")
  createdAt  DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([workspaceId, type, day])
  @@index([orgId])
}

model UsageEvent {
  id             String           @id @default(uuid())
  org            Business         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId          String
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId         String?
  featureKey     UsageFeatureKey
  quantity       Int
  occurredAt     DateTime
  cycleKey       String
  idempotencyKey String
  source         UsageEventSource @default(APP)
  metadata       Json?
  createdAt      DateTime         @default(now())

  @@unique([orgId, idempotencyKey])
  @@index([orgId, occurredAt])
  @@index([orgId, cycleKey])
  @@index([orgId, featureKey])
}

model UsageDailyRollup {
  id            String          @id @default(uuid())
  org           Business        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId         String
  featureKey    UsageFeatureKey
  day           DateTime
  cycleKey      String
  totalQuantity Int
  updatedAt     DateTime        @updatedAt

  @@unique([orgId, featureKey, day, cycleKey])
  @@index([orgId, cycleKey, day])
}

model UsageCycleTotal {
  id           String          @id @default(uuid())
  org          Business        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId        String
  featureKey   UsageFeatureKey
  cycleKey     String
  usedQuantity Int             @default(0)
  updatedAt    DateTime        @updatedAt

  @@unique([orgId, featureKey, cycleKey])
  @@index([orgId, cycleKey])
}

model OrgSubscription {
  id                    String                @id @default(uuid())
  org                   Business              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId                 String                @unique
  planId                SubscriptionPlan
  status                OrgSubscriptionStatus @default(ACTIVE)
  billingInterval       OrgBillingInterval    @default(MONTHLY)
  provider              PaymentProvider?
  providerCustomerId    String?
  providerSubscriptionId String?
  paidThroughAt         DateTime?
  usageCycleAnchorDay   Int
  activationTimestamp   DateTime
  currentCycleStartAt   DateTime
  currentCycleEndAt     DateTime
  apiAccessEnabled      Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([status])
  @@index([currentCycleEndAt])
}

model Transaction {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  currency  String
  amount    Decimal  @db.Decimal(14, 2)
  status    String
  reference String   @unique
  metadata  Json?
  createdAt DateTime @default(now())
}

// NextAuth models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
