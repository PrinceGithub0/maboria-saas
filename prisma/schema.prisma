generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  OPS_ADMIN
  STAFF
  DISABLED
}

enum UserStatus {
  ACTIVE
  PENDING
  DISABLED
  SUSPENDED
}

enum AuthProvider {
  PASSWORD
  GOOGLE
  SSO
}

enum SubscriptionPlan {
  STARTER
  PRO
  GROWTH
  BUSINESS
  ENTERPRISE
  PREMIUM
}

enum SubscriptionStatus {
  INCOMPLETE
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INACTIVE
  REVOKED
}

enum VatPricingMode {
  EXCLUSIVE
  INCLUSIVE
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
  STRIPE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum CheckoutStatus {
  CREATED
  REDIRECTED
  SUCCESS
  FAILED
  ABANDONED
}

enum PayoutType {
  LOCAL
  SEPA
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AutomationRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum AutomationRecoveryStatus {
  FAILED
  RETRYING
  RESOLVED
  REPLAYED
}

enum AutomationStepStatus {
  STARTED
  SUCCESS
  FAILED
  SKIPPED
}

enum AutomationReplayAttemptStatus {
  STARTED
  BLOCKED
  SUCCEEDED
  FAILED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  FAILED
  OVERDUE
  CANCELED
  EXPIRED
}

enum DeliveryPreference {
  EMAIL
  WHATSAPP
  BOTH
}

enum CustomerStatus {
  ACTIVE
  DISABLED
}

enum LateFeeType {
  FIXED
  PERCENTAGE
}

enum LateFeeMode {
  ONE_TIME
  RECURRING
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportThreadStatus {
  OPEN
  PENDING
  CLOSED
}

enum SupportThreadPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportSlaMetricStatus {
  RUNNING
  PAUSED
  MET
  BREACHED
  STOPPED
}

enum SupportSenderType {
  SUBSCRIBER
  ADMIN
  SYSTEM
}

enum SupportDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum SupportMessageChannel {
  APP
  EMAIL
  SYSTEM
}

enum ConnectedMailboxProvider {
  GMAIL
  OUTLOOK
  IMAP
  SMTP
}

enum ConnectedMailboxStatus {
  PENDING
  ACTIVE
  DISCONNECTED
  ERROR
}

enum CustomerMailboxConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum CustomerMailboxChannelType {
  EMAIL
  WHATSAPP
  SMS
}

enum CustomerMailboxSenderType {
  SUBSCRIBER
  CUSTOMER
  SYSTEM
}

enum AdminNotificationType {
  SYSTEM
  AUTOMATION
  SLA
  SUPPORT
  SECURITY
  BILLING
  INCIDENT
}

enum AdminNotificationSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AdminNotificationStatus {
  UNREAD
  READ
  ACKNOWLEDGED
  RESOLVED
  SNOOZED
}

enum AdminNotificationRecipientStrategy {
  ALL_ADMINS
  SUPER_ADMINS
  ASSIGNEE_ONLY
  ROLE
  CUSTOM_QUERY
}

enum AdminNotificationDedupeStrategy {
  BY_EVENT
  BY_TENANT
  BY_TENANT_AND_EVENT
  CUSTOM_KEY
}

enum AdminIncidentStatus {
  ACTIVE
  RESOLVED
}

enum SystemEventSeverity {
  INFO
  WARNING
  CRITICAL
}

enum SystemEventSource {
  BILLING
  AUTH
  AUTOMATION
  INBOX
  SUPPORT
  SYSTEM
}

enum AnalyticsCategory {
  INVOICE_CREATED
  AUTOMATION_SUCCESS
  AI_REQUEST
}

enum AnalyticsEventType {
  AI_REQUEST
  AI_TOKENS
  INVOICE_SENT
  AUTOMATION_RUN
  WHATSAPP_MESSAGE
  WHATSAPP_MESSAGE_SENT
}

enum UsageFeatureKey {
  AI_REQUESTS
  INVOICES
  WHATSAPP_MESSAGES
  AUTOMATIONS_RUNS
  TEAM_MEMBERS_SEATS
}

enum UsageEventSource {
  APP
  SYSTEM
  WEBHOOK
  BACKFILL
}

enum OrgSubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum BusinessAccessStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum OrgBillingInterval {
  MONTHLY
  YEARLY
}

enum ConversationStatus {
  OPEN
  PENDING
  DONE
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSource {
  WHATSAPP
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum UnifiedInboxType {
  EMAIL
  WHATSAPP
}

enum UnifiedInboxStatus {
  ACTIVE
  DISCONNECTED
  ERROR
  DISABLED
}

enum UnifiedConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum UnifiedMessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
  SYSTEM
}

enum UnifiedMessageChannel {
  EMAIL
  WHATSAPP
}

enum UnifiedDeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
}

model User {
  id             String             @id @default(cuid())
  name           String
  email          String             @unique
  publicId       String?            @unique
  emailVerified  DateTime?
  passwordHash   String
  role           Role               @default(USER)
  status         UserStatus         @default(ACTIVE)
  authProvider   AuthProvider       @default(PASSWORD)
  isPlatformUser Boolean            @default(false)
  lastLoginAt    DateTime?
  createdAt      DateTime           @default(now())
  onboardingComplete Boolean        @default(false)
  tourComplete   Boolean            @default(false)
  preferredCurrency String          @default("USD")
  locale         String?
  timeZone       String?
  twoFactorEnabled Boolean          @default(false)
  twoFactorSecret  String?
  twoFactorBackupCodes Json?
  requirePasswordReset Boolean      @default(false)
  archivedAt      DateTime?
    subscriptions  Subscription[]
    checkoutSessions CheckoutSession[]
  payments       Payment[]
  invoicePayments InvoicePayment[]
  reminderDispatches ReminderDispatch[]
  subscriberSetting SubscriberSetting?
  receipts      Receipt[]
  automationFlows AutomationFlow[]
  automationRuns AutomationRun[]    @relation("UserAutomationRuns")
  automationReplayAttempts AutomationReplayAttempt[]
  invoices       Invoice[]
  customers      Customer[]
    activityLogs   ActivityLog[]
    auditLogs      AuditLog[]
  supportTickets SupportTicket[]
  supportThreadTicketsAsSubscriber SupportThreadTicket[] @relation("SupportThreadSubscriber")
  supportThreadTicketsAsAssignee SupportThreadTicket[] @relation("SupportThreadAssignee")
  supportThreadMessages SupportThreadMessage[] @relation("SupportThreadMessageSender")
  supportThreadNotes SupportThreadInternalNote[] @relation("SupportThreadNoteAuthor")
  connectedMailboxes ConnectedMailbox[]
  customerMailboxConversations CustomerMailboxConversation[] @relation("CustomerMailboxConversationSubscriber")
  customerMailboxMessages CustomerMailboxMessage[] @relation("CustomerMailboxMessageSubscriber")
  sessions       Session[]
  accounts       Account[]
  resetTokens    PasswordResetToken[]
  adminStepUpTokens AdminStepUpToken[]
  actorImpersonationSessions ImpersonationSession[] @relation("ImpersonationActor")
  targetImpersonationSessions ImpersonationSession[] @relation("ImpersonationTarget")
  businesses     BusinessMember[]
  businessProfile BusinessProfile?
  merchantAccount MerchantAccount?
  notifications  Notification[]
  adminNotificationsReceived AdminNotification[] @relation("AdminNotificationRecipient")
  adminNotificationsAcknowledged AdminNotification[] @relation("AdminNotificationAcknowledgedBy")
  adminNotificationsResolved AdminNotification[] @relation("AdminNotificationResolvedBy")
  adminNotificationAudits AdminNotificationAudit[] @relation("AdminNotificationAuditActor")
  adminIncidentsCreated AdminIncident[] @relation("AdminIncidentCreator")
  aiMemories     AiMemory[]
  aiConversations AiConversation[]
  aiMessages     AiMessage[]
  twoFactorTokens TwoFactorToken[]
  aiUsageLogs    AiUsageLog[]
  ticketMessages TicketMessage[]
  ownedBusinesses Business[]     @relation("OwnedBusinesses")
  usageRecords   UsageRecord[]
  transactions   Transaction[]
  analyticsEvents AnalyticsEvent[]
  usageEvents   UsageEvent[]
  assignedConversations Conversation[] @relation("AssignedConversations")
  assignedUnifiedConversations UnifiedConversation[] @relation("UnifiedAssignedConversations")
  cannedReplies  CannedReply[]
  conversationNotes ConversationNote[]
  messageAudits  MessageAudit[]
  unifiedNotes   UnifiedNote[] @relation("UnifiedNoteAuthor")
  unifiedAuditEvents UnifiedAuditEvent[] @relation("UnifiedAuditActor")
  userActivityLogs UserActivityLog[] @relation("UserActivityTimelineUser")
  userActivityLogsAsActor UserActivityLog[] @relation("UserActivityTimelineActor")
  systemEventsAsUser SystemEvent[] @relation("SystemEventUser")
  systemEventsAsActor SystemEvent[] @relation("SystemEventActor")

  @@index([role])
  @@index([status])
  @@index([lastLoginAt])
  @@index([createdAt, id])
}

model Subscription {
  id          String             @id @default(cuid())
  user        User               @relation(fields: [userId], references: [id])
  userId      String
  plan        SubscriptionPlan
  status      SubscriptionStatus
  renewalDate DateTime
  trialEndsAt DateTime?
  usageLimit  Int?
  usagePeriod String?            @default("monthly")
  currency    String             @default("USD")
  autoRenew   Boolean            @default(true)
  cancelAtPeriodEnd Boolean      @default(false)
  provider    PaymentProvider?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  graceEndsAt DateTime?
  cancellationReason String?
  overageUsed Int               @default(0)
  interval    String            @default("monthly")
  pendingPlan SubscriptionPlan?
  pendingEffectiveAt DateTime?
  receiptUrl  String?
  receiptNumber String?
  receiptIssuedAt DateTime?
  lastPaymentReference String?
  lastPaymentProvider PaymentProvider?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
    invoices    Invoice[]
    checkoutSessions CheckoutSession[]
}

model CheckoutSession {
  id          String         @id @default(cuid())
  user        User           @relation(fields: [userId], references: [id])
  userId      String
  subscription Subscription  @relation(fields: [subscriptionId], references: [id])
  subscriptionId String
  plan        SubscriptionPlan
  billingCycle String
  provider    PaymentProvider
  currency    String
  amount      Decimal        @db.Decimal(14, 2)
  reference   String         @unique
  status      CheckoutStatus @default(CREATED)
  providerPayload Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Payment {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id])
  userId    String
  amount    Decimal          @db.Decimal(14, 2)
  currency  String
  provider  PaymentProvider
  status    PaymentStatus
  createdAt DateTime         @default(now())
  metadata  Json?
  reference String?
  gatewayResponse Json?
  originalAmount Decimal?    @db.Decimal(14, 2)
  originalCurrency String?
  amountUsd Decimal?         @db.Decimal(14, 2)
  amountNgn Decimal?         @db.Decimal(14, 2)
  conversations Conversation[] @relation("PaymentConversations")

  @@unique([provider, reference])
}

model AutomationFlow {
  id          String           @id @default(cuid())
  user        User             @relation(fields: [userId], references: [id])
  userId      String
  business    Business?        @relation(fields: [businessId], references: [id])
  businessId  String?
  title       String
  description String
  steps       Json
  category    String?
  aiParams    Json?
  status      AutomationStatus @default(DRAFT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  runs        AutomationRun[]
  triggers    Trigger[]
  actions     Action[]
}

model AutomationRun {
  id         String              @id @default(cuid())
  flow       AutomationFlow      @relation(fields: [flowId], references: [id])
  flowId     String
  originalRun   AutomationRun?   @relation("AutomationRunReplay", fields: [originalRunId], references: [id])
  replayRuns    AutomationRun[]  @relation("AutomationRunReplay")
  originalRunId String?          @map("original_run_id")
  runStatus  AutomationRunStatus @default(PENDING)
  recoveryStatus AutomationRecoveryStatus?
  logs       Json
  output     Json?
  createdAt  DateTime            @default(now())
  user       User                @relation("UserAutomationRuns", fields: [userId], references: [id])
  userId     String
  startedAt  DateTime?           @default(now())
  completedAt DateTime?
  lastRetryAt DateTime?          @map("last_retry_at")
  retryCount Int                 @default(0)
  errors     AutomationRunError[]
  stepExecutions AutomationStepExecution[]
  replayAttempts AutomationReplayAttempt[]
  replayedFromAttempts AutomationReplayAttempt[] @relation("AutomationReplayAttemptNewRun")

  @@index([createdAt])
  @@index([flowId, createdAt])
  @@index([userId, createdAt])
  @@index([runStatus, createdAt])
  @@index([recoveryStatus, createdAt])
  @@index([originalRunId, createdAt])
}

model AutomationRunError {
  id         String   @id @default(cuid())
  run        AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId      String
  flowId     String
  userId     String
  stepId     String?
  stepIndex  Int?
  errorType  String
  message    String
  stackTrace String?
  transient  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([runId, createdAt])
  @@index([flowId, createdAt])
  @@index([userId, createdAt])
}

model AutomationStepExecution {
  id             String   @id @default(cuid())
  run            AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId          String
  executionKey   String   @unique
  originalRunId  String?
  stepId         String
  stepIndex      Int
  stepType       String
  status         AutomationStepStatus @default(STARTED)
  startedAt      DateTime? @default(now())
  finishedAt     DateTime?
  durationMs     Int?
  errorMessage   String?
  errorCode      String?
  safeOutput     Json?
  createdAt      DateTime @default(now())

  @@index([runId, createdAt])
  @@index([runId, stepIndex])
  @@index([originalRunId, stepId, stepIndex])
}

model AutomationReplayAttempt {
  id           String                       @id @default(cuid())
  run          AutomationRun                @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId        String
  newRun       AutomationRun?               @relation("AutomationReplayAttemptNewRun", fields: [newRunId], references: [id], onDelete: SetNull)
  newRunId     String?
  actorAdmin   User                         @relation(fields: [actorAdminId], references: [id], onDelete: Cascade)
  actorAdminId String
  actorIp      String?
  createdAt    DateTime                     @default(now())
  resultStatus AutomationReplayAttemptStatus
  blockReason  String?
  reason       String?

  @@index([runId, createdAt])
  @@index([actorAdminId, createdAt])
}

model Invoice {
  id            String        @id @default(cuid())
  user          User          @relation(fields: [userId], references: [id])
  userId        String
  invoiceNumber String        @unique
  poNumber      String?
  items         Json
  total         Decimal       @db.Decimal(14, 2)
  lateFeeAmount Decimal       @default(0) @db.Decimal(14, 2)
  lateFeeTotalAccumulated Decimal @default(0) @db.Decimal(14, 2)
  lateFeeCount Int           @default(0)
  lateFeeAppliedAt DateTime?
  lastLateFeeAppliedAt DateTime?
  lateFeeLocked Boolean       @default(false)
  currency      String
  status        InvoiceStatus
  generatedAt   DateTime      @default(now())
  tax           Decimal?      @db.Decimal(14, 2)
  discount      Decimal?      @db.Decimal(14, 2)
  metadata      Json?
  pdfUrl        String?
  invoicePayments InvoicePayment[]
  supportingFiles InvoiceSupportingFile[]
  publicLinks   InvoicePublicLink[]
  receipts      Receipt[]
  reminderDispatches ReminderDispatch[]
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId String?
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  invoiceCustomerSnapshot Json?
  plan          SubscriptionPlan?
  conversations Conversation[] @relation("InvoiceConversations")

  @@index([userId])
  @@index([customerId])
}

model InvoiceSupportingFile {
  id          String  @id
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  filename    String
  contentType String
  sizeBytes   Int
  storageKey  String  @unique
  content     Bytes
  createdAt   DateTime @default(now())

  @@index([invoiceId, createdAt])
}

model Customer {
  id                 String             @id @default(cuid())
  user               User               @relation(fields: [userId], references: [id])
  userId             String
  name               String
  email              String
  phone              String?
  taxId              String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  state              String?
  postalCode         String?
  country            String?
  deliveryPreference DeliveryPreference @default(EMAIL)
  status             CustomerStatus     @default(ACTIVE)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  invoices           Invoice[]
  reminderDispatches ReminderDispatch[]
  unifiedConversations UnifiedConversation[]
  customerMailboxConversations CustomerMailboxConversation[]

  @@index([userId])
  @@unique([userId, email])
}

model SubscriberSetting {
  id                           String      @id @default(cuid())
  user                         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                       String      @unique
  lateFeeEnabled               Boolean     @default(false)
  lateFeeType                  LateFeeType @default(FIXED)
  lateFeeValue                 Decimal     @default(0) @db.Decimal(14, 2)
  gracePeriodDays              Int         @default(0)
  lateFeeMode                  LateFeeMode @default(ONE_TIME)
  lateFeeIntervalDays          Int?
  allowAutomationLateFee       Boolean     @default(false)
  maxLateFeeApplications       Int?
  lateFeeGraceDays             Int         @default(0)
  lateFeeCap                   Decimal?    @db.Decimal(14, 2)
  lateFeeRecurring             Boolean     @default(false)
  lateFeeRecurringIntervalDays Int?
  lateFeePolicyText            String?
  reminderCooldownMinutes      Int         @default(10)
  createdAt                    DateTime    @default(now())
  updatedAt                    DateTime    @updatedAt
}

model ReminderDispatch {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId  String
  channel    String
  dedupeKey  String   @unique
  createdAt  DateTime @default(now())

  @@index([userId, invoiceId, createdAt])
}

model InvoicePayment {
  id        String         @id @default(cuid())
  invoice   Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  user      User           @relation(fields: [userId], references: [id])
  userId    String
  provider  PaymentProvider
  status    PaymentStatus
  amount    Decimal        @db.Decimal(14, 2)
  currency  String
  amountOriginal  Decimal? @db.Decimal(14, 2)
  currencyOriginal String?
  fxRateUsed      Decimal? @db.Decimal(18, 8)
  amountConverted Decimal? @db.Decimal(14, 2)
  currencyDefault String?
  confirmedAt     DateTime?
  viaSubaccount   Boolean  @default(true)
  isManual        Boolean  @default(false)
  refundOfId      String?
  refundOf        InvoicePayment?  @relation("InvoicePaymentRefundChain", fields: [refundOfId], references: [id], onDelete: SetNull)
  refundEntries   InvoicePayment[] @relation("InvoicePaymentRefundChain")
  reference String
  metadata  Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  receipt   Receipt?

  @@index([invoiceId])
  @@index([userId])
  @@index([userId, confirmedAt])
  @@index([refundOfId])
  @@unique([provider, reference])
}

model InvoicePublicLink {
  id        String   @id @default(cuid())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String
  token     String   @unique
  createdAt DateTime @default(now())
  usedAt    DateTime?
  expiresAt DateTime?

  @@index([invoiceId])
}

model Receipt {
  id              String          @id @default(cuid())
  invoicePayment  InvoicePayment  @relation(fields: [invoicePaymentId], references: [id], onDelete: Cascade)
  invoicePaymentId String         @unique
  invoice         Invoice         @relation(fields: [invoiceId], references: [id])
  invoiceId       String
  user            User            @relation(fields: [userId], references: [id])
  userId          String
  receiptNumber   String          @unique
  amount          Decimal         @db.Decimal(14, 2)
  currency        String
  provider        PaymentProvider
  paymentMethod   String?
  reference       String?
  customerEmail   String?
  issuedAt        DateTime        @default(now())
  pdfUrl          String?
  metadata        Json?

  @@index([invoiceId])
  @@index([userId])
}

model ActivityLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  action    String
  timestamp DateTime @default(now())
  metadata  Json?
  resourceType String?
  resourceId String?
  ip        String?
  userAgent String?

  @@index([timestamp])
  @@index([userId, timestamp])
}

model SystemEvent {
  id         String              @id @default(cuid())
  tenant     Business?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  tenantId   String?             @map("tenant_id")
  user       User?               @relation("SystemEventUser", fields: [userId], references: [id], onDelete: SetNull)
  userId     String?             @map("user_id")
  actor      User?               @relation("SystemEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?             @map("actor_id")
  eventType  String              @map("event_type")
  severity   SystemEventSeverity @default(INFO)
  source     SystemEventSource
  entityType String?             @map("entity_type")
  entityId   String?             @map("entity_id")
  message    String
  metadata   Json?               @default("{}")
  requestId  String?             @map("request_id")
  createdAt  DateTime            @default(now()) @map("created_at")

  @@index([createdAt, id], map: "index_system_events_created")
  @@index([tenantId, createdAt, id], map: "index_system_events_tenant_created")
  @@index([eventType, createdAt, id], map: "index_system_events_event_type_created")
  @@index([severity, createdAt, id], map: "index_system_events_severity_created")
  @@index([entityId], map: "index_system_events_entity_id")
  @@index([requestId], map: "index_system_events_request_id")
  @@map("system_events")
}

model UserActivityLog {
  id        String   @id @default(cuid())
  tenant    Business @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId  String   @map("tenant_id")
  user      User     @relation("UserActivityTimelineUser", fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id")
  eventType String   @map("event_type")
  actor     User?    @relation("UserActivityTimelineActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId   String?  @map("actor_id")
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId], map: "index_user_activity_user")
  @@index([tenantId], map: "index_user_activity_tenant")
  @@index([createdAt], map: "index_user_activity_created")
  @@index([userId, createdAt])
  @@index([userId, createdAt, id])
  @@map("user_activity_logs")
}

model AuditLog {
  id           String   @id @default(cuid())
  user         User?    @relation(fields: [userId], references: [id])
  userId       String?
  orgId        String?
  action       String
  actionType   String?
  targetUserId String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model AiUsageLog {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  model     String
  tokens    Int
  prompt    String?
  createdAt DateTime @default(now())
  subscriptionId String?
}

model RateLimitLog {
  id        String   @id @default(cuid())
  key       String
  count     Int
  window    String
  createdAt DateTime @default(now())
}

model WebhookEvent {
  id         String   @id @default(cuid())
  provider   String
  eventId    String
  receivedAt DateTime @default(now())
